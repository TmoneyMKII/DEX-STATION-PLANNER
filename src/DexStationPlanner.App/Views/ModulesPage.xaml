<UserControl x:Class="DexStationPlanner.App.Views.ModulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DexStationPlanner.App.ViewModels"
             xmlns:controls="clr-namespace:DexStationPlanner.App.Controls"
             xmlns:model="clr-namespace:DexStationPlanner.Core.Model;assembly=DexStationPlanner.Core"
             xmlns:modules="clr-namespace:DexStationPlanner.Core.Modules;assembly=DexStationPlanner.Core"
             xmlns:editors="clr-namespace:DexStationPlanner.App.Editors"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ModulesViewModel}"
             d:DesignWidth="1300" d:DesignHeight="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="310" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Left: module library and equipment palette -->
        <Border Style="{StaticResource Dex.Panel}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.3*" MinHeight="150" />
                </Grid.RowDefinitions>

                <DockPanel Margin="12,10,8,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Dex.IconButton}" ToolTip="New module from template" Click="NewModuleButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE710;" FontSize="13" />
                            <TextBlock Text="New" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="TemplateMenu" ItemsSource="{Binding Templates}" DisplayMemberPath="Name"
                                         MenuItem.Click="TemplateMenu_Click" />
                        </Button.ContextMenu>
                    </Button>
                    <TextBlock Text="Module library" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox x:Name="LibraryList" Grid.Row="1" ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedModule}"
                         BorderThickness="0" Background="Transparent" Margin="4,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:ModuleDefinition}">
                            <DockPanel Margin="0,2">
                                <Border DockPanel.Dock="Left" Width="10" Height="28" CornerRadius="2" Margin="0,0,8,0"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource Dex.TextMuted}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Grid.Row="2" Margin="8,4">
                    <Button Style="{StaticResource Dex.IconButton}" Command="{Binding DuplicateModuleCommand}" ToolTip="Duplicate">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE8C8;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Dex.IconButton}" Command="{Binding DeleteModuleCommand}" ToolTip="Delete module">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE74D;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Dex.IconButton}" Command="{Binding ImportModuleCommand}" ToolTip="Import a .dexmodule file">
                        <TextBlock Text="Import" />
                    </Button>
                    <Button Style="{StaticResource Dex.IconButton}" Command="{Binding ExportModuleCommand}" ToolTip="Export this module to share it">
                        <TextBlock Text="Export" />
                    </Button>
                </WrapPanel>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Dex.Border}" />

                <DockPanel Grid.Row="4">
                    <TextBlock DockPanel.Dock="Top" Text="Equipment" FontWeight="SemiBold" Margin="12,10,8,6" />
                    <TextBox DockPanel.Dock="Top" Margin="10,0,10,6" Text="{Binding EquipmentFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter equipment by name or category" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Dex.Muted}" FontSize="11" Margin="12,4,12,8"
                               Text="Drag onto the plan, or double-click then click to place." />
                    <ListBox x:Name="EquipmentList" ItemsSource="{Binding EquipmentView}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             PreviewMouseLeftButtonDown="EquipmentList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="EquipmentList_PreviewMouseMove"
                             MouseDoubleClick="EquipmentList_MouseDoubleClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Dex.SectionHeader}" Margin="8,8,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:EquipmentDefinition}">
                                <DockPanel ToolTip="{Binding Description}">
                                    <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="2" Margin="0,0,8,0"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Center: floor plan editor + 3D preview -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="PreviewRow" Height="300" MinHeight="0" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Dex.Surface}" BorderBrush="{DynamicResource Dex.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <WrapPanel>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="ModuleTool" ToolTip="Select and move (V)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Select}">Select</RadioButton>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="ModuleTool" ToolTip="Draw the outer shell: click corners, click the first corner (or Enter) to close (S)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Shell}">Shell</RadioButton>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="ModuleTool" ToolTip="Interior wall: click start, click end, keep clicking to chain. Shift for 45° (W)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Wall}">Wall</RadioButton>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="ModuleTool" ToolTip="Curved wall: click start, click end, then click to set the curve (A)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=ArcWall}">Curved wall</RadioButton>
                    <Border Style="{StaticResource Dex.Divider}" />
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="ModuleTool" ToolTip="Click a wall to add a door (D)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Door}">Door</RadioButton>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="ModuleTool" ToolTip="Click a wall to add a window (N)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Window}">Window</RadioButton>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="ModuleTool" ToolTip="Click the shell to add a connector where other modules can join (C)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Connector}">Connector</RadioButton>
                    <Border Style="{StaticResource Dex.Divider}" />
                    <Button Style="{StaticResource Dex.IconButton}" ToolTip="Rotate selected equipment 90° (R)" Click="Rotate_Click">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE7AD;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Dex.IconButton}" ToolTip="Delete selection (Del)" Click="Delete_Click">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE74D;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Dex.IconButton}" ToolTip="Zoom to fit" Click="ZoomFit_Click">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE9A6;" FontSize="14" />
                    </Button>
                    <Border Style="{StaticResource Dex.Divider}" />
                    <TextBlock Text="Grid" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{DynamicResource Dex.TextMuted}" />
                    <ComboBox ItemsSource="{Binding GridOptions}" DisplayMemberPath="Label" SelectedValuePath="Meters"
                              SelectedValue="{Binding GridStep}" MinWidth="80" />
                    <CheckBox Content="Snap" IsChecked="{Binding SnapEnabled}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Snap to grid (hold Alt to bypass)" />
                    <CheckBox Content="3D preview" IsChecked="{Binding ShowPreview}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
            </Border>

            <controls:FloorPlanCanvas x:Name="Plan" Grid.Row="1"
                                      Module="{Binding SelectedModule}"
                                      Catalog="{Binding Catalog}"
                                      Tool="{Binding Tool, Mode=TwoWay}"
                                      Selection="{Binding Selection, Mode=TwoWay}"
                                      PlacingEquipmentId="{Binding PlacingEquipmentId}"
                                      GridStep="{Binding GridStep}"
                                      SnapEnabled="{Binding SnapEnabled}"
                                      Units="{Binding Project.DisplayUnits}" />

            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Dex.Muted}"
                       Text="Create or select a module in the library to start designing."
                       Visibility="{Binding SelectedModule, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />

            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Dex.Border}"
                          Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}" />
            <controls:ModulePreview3D x:Name="Preview" Grid.Row="3" Module="{Binding SelectedModule}" Catalog="{Binding Catalog}"
                                      Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Right: properties -->
        <Border Grid.Column="4" Style="{StaticResource Dex.Panel}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,10,14,16">
                    <StackPanel Visibility="{Binding SelectedEditor, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding SelectedEditor.Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                        <ContentControl Content="{Binding SelectedEditor}" Focusable="False" />
                        <Border Height="1" Background="{DynamicResource Dex.Border}" Margin="0,14,0,0" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding ModuleEditor}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="Module" Margin="0,8,0,8" />
                        <TextBlock Style="{StaticResource Dex.Label}" Text="Name" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Module.Name}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Dex.Label}" Text="Category" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Module.Category}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Dex.Label}" Text="Color" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="2" Margin="0,0,4,0"
                                            Background="{Binding Module.Color, Converter={StaticResource HexToBrush}}" />
                                    <TextBox Text="{Binding Module.Color}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}"><Run Text="Wall height" /> (<Run Text="{Binding LengthUnit, Mode=OneWay}" />)</TextBlock>
                            <TextBox Grid.Column="1" Text="{Binding WallHeight, StringFormat=0.###}" />
                        </Grid>
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}"><Run Text="Shell thickness" /> (<Run Text="{Binding LengthUnit, Mode=OneWay}" />)</TextBlock>
                            <TextBox Grid.Column="1" Text="{Binding ShellThickness, StringFormat=0.###}" />
                        </Grid>
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}"><Run Text="Floor thickness" /> (<Run Text="{Binding LengthUnit, Mode=OneWay}" />)</TextBlock>
                            <TextBox Grid.Column="1" Text="{Binding FloorThickness, StringFormat=0.###}" />
                        </Grid>
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}" ToolTip="Height of the floor underside above grade. Above zero, the module stands on stilts."><Run Text="Elevation" /> (<Run Text="{Binding LengthUnit, Mode=OneWay}" />)</TextBlock>
                            <TextBox Grid.Column="1" Text="{Binding Elevation, StringFormat=0.###}" />
                        </Grid>
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}"><Run Text="Structure mass" /> (<Run Text="{Binding MassUnit, Mode=OneWay}" />)</TextBlock>
                            <TextBox Grid.Column="1" Text="{Binding StructureMass, StringFormat=0}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Dex.Label}" Text="Description" Margin="0,4,0,4" />
                        <TextBox Text="{Binding Module.Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="Totals" Visibility="{Binding SelectedModule, Converter={StaticResource NullToVisibility}}" />
                    <ContentControl Content="{Binding Stats}" ContentTemplate="{StaticResource Dex.StatsList}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

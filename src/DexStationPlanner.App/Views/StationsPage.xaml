<UserControl x:Class="DexStationPlanner.App.Views.StationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DexStationPlanner.App.ViewModels"
             xmlns:controls="clr-namespace:DexStationPlanner.App.Controls"
             xmlns:model="clr-namespace:DexStationPlanner.Core.Model;assembly=DexStationPlanner.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StationsViewModel}"
             d:DesignWidth="1300" d:DesignHeight="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="310" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Left: stations and module palette -->
        <Border Style="{StaticResource Dex.Panel}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="80" MaxHeight="260" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="12,10,8,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Dex.IconButton}" Command="{Binding AddStationCommand}" ToolTip="New station">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE710;" FontSize="13" />
                            <TextBlock Text="New" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Stations" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding StationList}" SelectedItem="{Binding SelectedStation}"
                         BorderThickness="0" Background="Transparent" Margin="4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:Station}">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource Dex.TextMuted}">
                                    <Run Text="{Binding Modules.Count, Mode=OneWay}" /> modules · <Run Text="{Binding Environment, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Grid.Row="2" Margin="8,4">
                    <Button Style="{StaticResource Dex.IconButton}" Command="{Binding DuplicateStationCommand}" ToolTip="Duplicate station">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE8C8;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Dex.IconButton}" Command="{Binding DeleteStationCommand}" ToolTip="Delete station">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE74D;" FontSize="14" />
                    </Button>
                </WrapPanel>

                <Border Grid.Row="3" Height="1" Background="{DynamicResource Dex.Border}" />

                <DockPanel Grid.Row="4">
                    <TextBlock DockPanel.Dock="Top" Text="Modules" FontWeight="SemiBold" Margin="12,10,8,2" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dex.Muted}" FontSize="11" Margin="12,0,12,6"
                               Text="Drag onto the site plan, or double-click to drop at the center." />
                    <ListBox x:Name="ModuleList" ItemsSource="{Binding Library}" BorderThickness="0" Background="Transparent" Margin="4,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="ModuleList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ModuleList_PreviewMouseMove"
                             MouseDoubleClick="ModuleList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:ModuleDefinition}">
                                <DockPanel Margin="0,2">
                                    <Border DockPanel.Dock="Left" Width="10" Height="28" CornerRadius="2" Margin="0,0,8,0"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource Dex.TextMuted}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Center: site plan -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Dex.Surface}" BorderBrush="{DynamicResource Dex.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <WrapPanel>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="SiteTool" ToolTip="Select, move and rotate modules (V)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Select}">Select</RadioButton>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="SiteTool" ToolTip="Join two connectors; a corridor fills any gap (L)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Link}">Corridor link</RadioButton>
                    <RadioButton Style="{StaticResource Dex.ToolButton}" GroupName="SiteTool" ToolTip="Route a utility line: click a module, click bends, click the destination module (U)"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Utility}">Utility run</RadioButton>
                    <ComboBox ItemsSource="{Binding UtilityKinds}" SelectedItem="{Binding UtilityKind}" MinWidth="110" Margin="4,0,0,0" ToolTip="Utility type for new runs" />
                    <Border Style="{StaticResource Dex.Divider}" />
                    <Button Style="{StaticResource Dex.IconButton}" ToolTip="Rotate selected module 90° (R)" Click="Rotate_Click">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE7AD;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Dex.IconButton}" ToolTip="Delete selection (Del)" Click="Delete_Click">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE74D;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Dex.IconButton}" ToolTip="Zoom to fit" Click="ZoomFit_Click">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE9A6;" FontSize="14" />
                    </Button>
                    <CheckBox Content="Snap to grid" IsChecked="{Binding SnapEnabled}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Hold Alt while dragging to place freely" />
                </WrapPanel>
            </Border>
            <controls:SitePlanCanvas x:Name="Site" Grid.Row="1"
                                     Station="{Binding SelectedStation}"
                                     Project="{Binding Project}"
                                     Tool="{Binding Tool, Mode=TwoWay}"
                                     Selection="{Binding Selection, Mode=TwoWay}"
                                     UtilityKind="{Binding UtilityKind}"
                                     SnapEnabled="{Binding SnapEnabled}"
                                     Units="{Binding Project.DisplayUnits}" />
            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Dex.Muted}"
                       Text="Create a station to start laying out modules."
                       Visibility="{Binding SelectedStation, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
        </Grid>

        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Right: properties -->
        <Border Grid.Column="4" Style="{StaticResource Dex.Panel}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,10,14,16">
                    <StackPanel Visibility="{Binding SelectedEditor, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding SelectedEditor.Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                        <ContentControl Content="{Binding SelectedEditor}" Focusable="False" />
                        <Border Height="1" Background="{DynamicResource Dex.Border}" Margin="0,14,0,0" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding SelectedStation}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="Station" Margin="0,8,0,8" />
                        <TextBlock Style="{StaticResource Dex.Label}" Text="Name" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Name}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Dex.Label}" Text="Environment" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DataContext.StationEditor.Environments, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding Environment}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Dex.Label}" Text="Description" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />

                        <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="Site location" />
                        <TextBlock Style="{StaticResource Dex.Muted}" Margin="0,0,0,6" Text="{Binding Site.SiteName}"
                                   Visibility="{Binding Site.SiteName, Converter={StaticResource NullToVisibility}}" />
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}" Text="Latitude (°)" />
                            <TextBox Grid.Column="1" Text="{Binding Site.Latitude, StringFormat=0.######}" />
                        </Grid>
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}" Text="Longitude (°)" />
                            <TextBox Grid.Column="1" Text="{Binding Site.Longitude, StringFormat=0.######}" />
                        </Grid>
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}" Text="Elevation (m)" ToolTip="Ground elevation above the WGS84 ellipsoid" />
                            <TextBox Grid.Column="1" Text="{Binding Site.GroundElevation, StringFormat=0.#}" />
                        </Grid>
                        <Grid Style="{StaticResource Dex.FieldGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource Dex.LabelColumn}" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Dex.Label}" Text="Grid heading (°)" ToolTip="Clockwise rotation of the site plan's 'up' from true north" />
                            <TextBox Grid.Column="1" Text="{Binding Site.GridHeadingDegrees, StringFormat=0.#}" />
                        </Grid>
                        <CheckBox Content="Placed on the globe" IsChecked="{Binding Site.IsPlaced}" Margin="0,2,0,8" />
                        <TextBlock Style="{StaticResource Dex.Label}" Text="Move to a known research site" Margin="0,0,0,4" />
                        <ComboBox x:Name="KnownSiteBox" ItemsSource="{Binding DataContext.KnownSites, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                  ToolTip="Move this station to a known research site" SelectionChanged="KnownSiteBox_SelectionChanged" />
                        <Button Content="Pick location on the globe" HorizontalAlignment="Stretch" Click="PickOnGlobe_Click" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="Station totals" Visibility="{Binding SelectedStation, Converter={StaticResource NullToVisibility}}" />
                    <ContentControl Content="{Binding Stats}" ContentTemplate="{StaticResource Dex.StatsList}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

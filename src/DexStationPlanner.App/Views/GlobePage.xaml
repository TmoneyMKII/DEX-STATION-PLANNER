<UserControl x:Class="DexStationPlanner.App.Views.GlobePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DexStationPlanner.App.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignWidth="1200" d:DesignHeight="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Grid Background="Black">
            <wv2:WebView2 x:Name="Web" />
            <TextBlock x:Name="WebStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA0A6"
                       TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center" Text="Loading globe…" />
        </Grid>

        <!-- Side panel (beside, not over, the WebView: native web content can't be overlaid by WPF) -->
        <Border Grid.Column="1" Style="{StaticResource Dex.Panel}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12">
                    <TextBlock Text="Globe" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Dex.Label}" Text="Station" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Stations.StationList}" SelectedItem="{Binding Stations.SelectedStation}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch" />

                    <StackPanel DataContext="{Binding Stations.SelectedStation}" Margin="0,12,0,0"
                                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <Border Style="{StaticResource Dex.Card}" Padding="12">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Site.SiteName, TargetNullValue='Custom location'}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Dex.Muted}" Margin="0,4,0,0" Visibility="{Binding Site.IsPlaced, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding Site.Latitude, Mode=OneWay, StringFormat={}{0:0.#####}°}" />,
                                    <Run Text="{Binding Site.Longitude, Mode=OneWay, StringFormat={}{0:0.#####}°}" /><LineBreak />
                                    <Run Text="Ground elevation" /> <Run Text="{Binding Site.GroundElevation, Mode=OneWay, StringFormat={}{0:N0} m}" />
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource Dex.Warning}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Not placed yet. Pick a spot on the globe or choose a known site below."
                                           Visibility="{Binding Site.IsPlaced, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button x:Name="PlaceButton" Content="Place station on the globe" Style="{DynamicResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="PlaceButton_Click" />
                    <Button Content="Fly to station" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="FlyButton_Click" />

                    <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="Add infrastructure" />
                    <TextBlock Style="{StaticResource Dex.Muted}" FontSize="11" Margin="0,0,0,6"
                               Text="Runways and piers: click both ends. Roads: click points, then double-click or press Enter. Everything else: one click." />
                    <DockPanel>
                        <Button x:Name="PlaceFeatureButton" DockPanel.Dock="Right" Content="Place" Margin="6,0,0,0" Click="PlaceFeatureButton_Click" />
                        <ComboBox ItemsSource="{Binding Stations.FeatureKinds}" SelectedItem="{Binding Stations.FeatureKind}" HorizontalAlignment="Stretch" />
                    </DockPanel>
                    <TextBlock x:Name="FeatureHint" Style="{StaticResource Dex.Muted}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Dex.Warning}"
                               Text="Place the station first; infrastructure is positioned relative to it." Visibility="Collapsed" />

                    <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="Known research sites" />
                    <TextBlock Style="{StaticResource Dex.Muted}" FontSize="11" Margin="0,0,0,6"
                               Text="Click to fly there. Use the button to move the selected station to that site." />
                    <ListBox x:Name="SiteList" ItemsSource="{Binding Stations.KnownSites}" BorderThickness="0" Background="Transparent"
                             SelectionChanged="SiteList_SelectionChanged" MaxHeight="360">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Dex.TextMuted}">
                                        <Run Text="{Binding Region, Mode=OneWay}" /> · <Run Text="{Binding Environment, Mode=OneWay}" /> · <Run Text="{Binding ElevationM, Mode=OneWay, StringFormat={}{0:N0} m}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Move station to selected site" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="UseSiteButton_Click" />

                    <TextBlock Style="{StaticResource Dex.Muted}" FontSize="11" Margin="0,16,0,0"
                               Text="Left-drag to pan, right-drag or wheel to zoom, middle-drag (or Ctrl+drag) to tilt. Add a Cesium ion token in Settings for 3D terrain." />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

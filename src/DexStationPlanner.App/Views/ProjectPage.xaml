<UserControl x:Class="DexStationPlanner.App.Views.ProjectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DexStationPlanner.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource Dex.PageTitle}" Text="Project" />
                <Border Style="{StaticResource Dex.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Dex.Label}" Text="Project name" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Dex.Label}" Text="Organization" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Project.Organization}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Dex.Label}" Text="Prepared by" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Project.Author}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Dex.Label}" Text="Description / purpose" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Project.Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource Dex.Muted}" Margin="0,10,0,0" FontSize="12"
                                   Text="These details will head the generated documentation package (coming in a later release)." />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="Getting started" />
                <Border Style="{StaticResource Dex.Card}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run FontWeight="SemiBold" Text="1. Design modules. " />
                            <Run Foreground="{DynamicResource Dex.TextMuted}" Text="Start from an ISO container or a custom shape, draw walls (straight or curved), cut doors and windows, add connectors, and drag equipment in." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run FontWeight="SemiBold" Text="2. Lay out stations. " />
                            <Run Foreground="{DynamicResource Dex.TextMuted}" Text="Drop modules on the site plan. Connectors snap together; link distant ones with corridors and route power, fuel, water and data lines." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run FontWeight="SemiBold" Text="3. Place it on Earth. " />
                            <Run Foreground="{DynamicResource Dex.TextMuted}" Text="Pick a spot on the 3D globe or jump to a known research site, and see the station in context." />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Design modules" Style="{DynamicResource AccentButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Modules}" Margin="0,0,8,0" />
                            <Button Content="Open the example station" Command="{Binding OpenExampleCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,44,0,0">
                <Border Style="{StaticResource Dex.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Dex.SectionHeader}" Text="At a glance" Margin="0,0,0,8" />
                        <Grid Margin="0,2">
                            <TextBlock Style="{StaticResource Dex.Label}" Text="Module designs" />
                            <TextBlock Style="{StaticResource Dex.Value}" Text="{Binding Project.Modules.Count}" />
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Style="{StaticResource Dex.Label}" Text="Stations" />
                            <TextBlock Style="{StaticResource Dex.Value}" Text="{Binding Project.Stations.Count}" />
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Style="{StaticResource Dex.Label}" Text="Display units" />
                            <TextBlock Style="{StaticResource Dex.Value}" Text="{Binding Project.DisplayUnits}" />
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Style="{StaticResource Dex.Label}" Text="Created" />
                            <TextBlock Style="{StaticResource Dex.Value}" Text="{Binding ProjectCreatedLocal, StringFormat={}{0:yyyy-MM-dd}}" />
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Style="{StaticResource Dex.Label}" Text="File" />
                            <TextBlock Style="{StaticResource Dex.Value}" Text="{Binding FilePath, TargetNullValue='Not saved yet'}" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding FilePath}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Dex.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Image Source="/Assets/dex-logo.png" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock FontWeight="SemiBold" Text="DEX Station Planner" />
                        <TextBlock Style="{StaticResource Dex.Muted}" Margin="0,4,0,0"
                                   Text="Free, open-source planning for remote research stations, by Diversified Exploration Works. Terrestrial sites today; extraterrestrial sites on the roadmap." />
                        <TextBlock Style="{StaticResource Dex.Muted}" Margin="0,8,0,0" Text="Coming next: logistics simulation (airfields, ports, helipads, science cargo) and one-click documentation packages (PDF)." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

<Window x:Class="DexStationPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DexStationPlanner.App.ViewModels"
        xmlns:views="clr-namespace:DexStationPlanner.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="Assets/dex.ico"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Dex.Background}"
        Foreground="{DynamicResource Dex.Text}">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Project}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Modules}" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Stations}" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Globe}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Dex.Surface}" BorderBrush="{DynamicResource Dex.Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="12,0">
                <Image DockPanel.Dock="Left" Source="Assets/dex-logo.png" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="Diversified Exploration Works" />
                <TextBlock DockPanel.Dock="Left" Text="Station Planner" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border DockPanel.Dock="Left" Style="{StaticResource Dex.Divider}" Height="22" />

                <Button DockPanel.Dock="Left" Style="{StaticResource Dex.IconButton}" ToolTip="New project (Ctrl+N)" x:Name="NewButton" Click="NewButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE710;" />
                        <TextBlock Text="New" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE70D;" FontSize="10" Margin="4,0,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Blank project" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                            <MenuItem Header="Example: Summit Field Camp" Command="{Binding OpenExampleCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource Dex.IconButton}" ToolTip="Open project (Ctrl+O)" x:Name="OpenButton" Click="OpenButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE8E5;" />
                        <TextBlock Text="Open" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE70D;" FontSize="10" Margin="4,0,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OpenMenu" />
                    </Button.ContextMenu>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource Dex.IconButton}" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE74E;" />
                        <TextBlock Text="Save" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource Dex.IconButton}" Command="{Binding SaveAsCommand}" ToolTip="Save as (Ctrl+Shift+S)">
                    <TextBlock Text="Save as…" VerticalAlignment="Center" />
                </Button>
                <Border DockPanel.Dock="Left" Style="{StaticResource Dex.Divider}" Height="22" />
                <Button DockPanel.Dock="Left" Style="{StaticResource Dex.IconButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                    <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE7A7;" />
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource Dex.IconButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                    <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE7A6;" />
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Metric" VerticalAlignment="Center" Foreground="{DynamicResource Dex.TextMuted}" Margin="0,0,6,0" />
                    <ToggleButton IsChecked="{Binding IsImperial}" Width="40" Height="20" ToolTip="Display units" Style="{StaticResource Dex.Switch}" />
                    <TextBlock Text="Imperial" VerticalAlignment="Center" Foreground="{DynamicResource Dex.TextMuted}" Margin="6,0,16,0" />
                    <Button Style="{StaticResource Dex.IconButton}" ToolTip="Toggle light/dark theme" Click="ThemeButton_Click">
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE706;" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigation rail -->
        <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Dex.Surface}" BorderBrush="{DynamicResource Dex.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource Dex.NavItem}" GroupName="Nav" ToolTip="Project overview (Ctrl+1)"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Project}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE80F;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Project" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Dex.NavItem}" GroupName="Nav" ToolTip="Design modules (Ctrl+2)"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Modules}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE8F1;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Modules" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Dex.NavItem}" GroupName="Nav" ToolTip="Lay out stations (Ctrl+3)"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Stations}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE81E;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Stations" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Dex.NavItem}" GroupName="Nav" ToolTip="Place on the globe (Ctrl+4)"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Globe}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE774;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Globe" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <RadioButton DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource Dex.NavItem}" GroupName="Nav" ToolTip="Settings"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Dex.Icon}" Text="&#xE713;" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </DockPanel>
        </Border>

        <!-- Pages stay alive while hidden so the globe and editor views keep their state. -->
        <Grid Grid.Row="1" Grid.Column="1">
            <views:ProjectPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Project}" />
            <views:ModulesPage DataContext="{Binding Modules}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Modules}" />
            <views:StationsPage DataContext="{Binding Stations}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibility}, ConverterParameter=Stations}" />
            <views:GlobePage x:Name="GlobePage" Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Globe}" />
            <views:SettingsPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Settings}" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource Dex.Surface}" BorderBrush="{DynamicResource Dex.Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Dex.TextMuted}" VerticalAlignment="Center"
                           Text="Free &amp; open source · Apache 2.0 · Diversified Exploration Works" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Dex.TextMuted}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

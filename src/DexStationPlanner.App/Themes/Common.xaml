<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Dex.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Dex.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Dex.IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dex.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Dex.Text}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Dex.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Dex.TextMuted}" />
        <Setter Property="Margin" Value="0,14,0,6" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="Dex.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Dex.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Dex.Value" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Dex.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="Dex.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Dex.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Dex.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Dex.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dex.Border}" />
    </Style>

    <Style x:Key="Dex.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Dex.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dex.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Left navigation rail item -->
    <Style x:Key="Dex.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Dex.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" Height="60" Margin="4,2">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="Pip" Width="3" Height="20" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource Dex.Accent}" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Dex.SurfaceAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource Dex.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Dex.SurfaceAlt}" />
                            <Setter TargetName="Pip" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Dex.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Editor tool button (one of a group) -->
    <Style x:Key="Dex.ToolButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Dex.Text}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Dex.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Dex.AccentSubtle}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Dex.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat icon button for toolbars -->
    <Style x:Key="Dex.IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Dex.Text}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Dex.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action button in solid DEX red. Replaces Fluent's AccentButtonStyle by key. -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource Dex.Accent}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="#33FFFFFF">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Dex.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact on/off switch -->
    <Style x:Key="Dex.Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource Dex.SurfaceAlt}"
                                BorderBrush="{DynamicResource Dex.Border}" BorderThickness="1" />
                        <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                 Fill="{DynamicResource Dex.TextMuted}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Dex.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Dex.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dex.Divider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{DynamicResource Dex.Border}" />
    </Style>
</ResourceDictionary>

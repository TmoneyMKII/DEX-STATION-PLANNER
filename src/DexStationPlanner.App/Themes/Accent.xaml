<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Overrides the Fluent theme's Windows accent color with DEX red. Fluent reads these color keys
      dynamically: the dark theme fills accent controls with Light2 (text with Light3), the light theme with Dark1.
      Light2 is the brand red itself so filled buttons and checkboxes match the logo.
    -->
    <Color x:Key="SystemAccentColor">#E51414</Color>
    <Color x:Key="SystemAccentColorLight1">#EC4545</Color>
    <Color x:Key="SystemAccentColorLight2">#E51414</Color>
    <Color x:Key="SystemAccentColorLight3">#F47A7A</Color>
    <Color x:Key="SystemAccentColorDark1">#C81010</Color>
    <Color x:Key="SystemAccentColorDark2">#A50C0C</Color>
    <Color x:Key="SystemAccentColorDark3">#7E0909</Color>
    <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
    <Color x:Key="TextOnAccentFillColorSecondary">#E6FFFFFF</Color>
    <Color x:Key="TextOnAccentFillColorSelectedText">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFF" />
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DEX palette, dark. Brand red sampled from the DEX Works logo (#E51414). -->
    <Color x:Key="Dex.AccentColor">#E51414</Color>
    <SolidColorBrush x:Key="Dex.Accent" Color="#E51414" />
    <SolidColorBrush x:Key="Dex.AccentHover" Color="#F23A3A" />
    <SolidColorBrush x:Key="Dex.AccentSubtle" Color="#33E51414" />
    <SolidColorBrush x:Key="Dex.Background" Color="#121417" />
    <SolidColorBrush x:Key="Dex.Surface" Color="#1A1D21" />
    <SolidColorBrush x:Key="Dex.SurfaceAlt" Color="#22262B" />
    <SolidColorBrush x:Key="Dex.Border" Color="#30353B" />
    <SolidColorBrush x:Key="Dex.Text" Color="#E8EAED" />
    <SolidColorBrush x:Key="Dex.TextMuted" Color="#9AA0A6" />
    <SolidColorBrush x:Key="Dex.Warning" Color="#F2B230" />
    <SolidColorBrush x:Key="Dex.Good" Color="#3FBF7F" />

    <!-- Plan canvases -->
    <SolidColorBrush x:Key="Dex.Canvas.Background" Color="#15181C" />
    <SolidColorBrush x:Key="Dex.Canvas.GridMinor" Color="#1F2328" />
    <SolidColorBrush x:Key="Dex.Canvas.GridMajor" Color="#2C3238" />
    <SolidColorBrush x:Key="Dex.Canvas.Axis" Color="#46505A" />
    <SolidColorBrush x:Key="Dex.Canvas.ShellFill" Color="#262B31" />
    <SolidColorBrush x:Key="Dex.Canvas.Shell" Color="#D9DEE3" />
    <SolidColorBrush x:Key="Dex.Canvas.Wall" Color="#9AA4AE" />
    <SolidColorBrush x:Key="Dex.Canvas.Text" Color="#C8CDD2" />
    <SolidColorBrush x:Key="Dex.Canvas.Dimension" Color="#5FB3F0" />
    <SolidColorBrush x:Key="Dex.Canvas.Handle" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Dex.Canvas.Selection" Color="#E51414" />
    <SolidColorBrush x:Key="Dex.Canvas.Preview" Color="#F2B230" />
    <SolidColorBrush x:Key="Dex.Canvas.Door" Color="#5FB3F0" />
    <SolidColorBrush x:Key="Dex.Canvas.Window" Color="#7FD4E8" />
    <Color x:Key="Dex.Preview3D.Background">#15181C</Color>
</ResourceDictionary>

<Application x:Class="DexStationPlanner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DexStationPlanner.App.Converters"
             xmlns:model="clr-namespace:DexStationPlanner.Core.Model;assembly=DexStationPlanner.Core"
             xmlns:logistics="clr-namespace:DexStationPlanner.Core.Logistics;assembly=DexStationPlanner.Core"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemeService swaps Dark/Light at index 0 at runtime. -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Accent.xaml" />
                <ResourceDictionary Source="Themes/Common.xaml" />
                <ResourceDictionary Source="Views/EditorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:HumanizeConverter x:Key="Humanize" />

            <!-- Readable names wherever these enums appear in combo boxes and lists. -->
            <DataTemplate DataType="{x:Type model:SiteFeatureKind}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
            <DataTemplate DataType="{x:Type model:SurfaceType}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
            <DataTemplate DataType="{x:Type model:PortKind}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
            <DataTemplate DataType="{x:Type model:UtilityKind}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
            <DataTemplate DataType="{x:Type model:ModuleCategory}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
            <DataTemplate DataType="{x:Type model:SiteEnvironment}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
            <DataTemplate DataType="{x:Type model:OpeningKind}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
            <DataTemplate DataType="{x:Type model:ConnectorKind}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
            <DataTemplate DataType="{x:Type logistics:TransportMode}"><TextBlock Text="{Binding Converter={StaticResource Humanize}}" /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Application x:Class="DexStationPlanner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DexStationPlanner.App.Converters"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemeService swaps Dark/Light at index 0 at runtime. -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Accent.xaml" />
                <ResourceDictionary Source="Themes/Common.xaml" />
                <ResourceDictionary Source="Views/EditorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
